<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Secret Game</title>
    <link rel="stylesheet" href="play.css" />
  </head>
  <body>
    <div class="container">
      <h1>Secret guessing game</h1>
      <p class="subtitle">Guess a number between 1 and 100</p>

      {{#if debugNumber}}
        <!-- {{debugNumber}} -->
      {{/if}}

      {{#if showInvalid}}
        <p class="status">invalid guess</p>
      {{/if}}

      {{#if hasWon}}
        <p>you won — {{guessCount}} guesses</p>
        <form action="reset" method="post">
          <button type="submit" autofocus>New game</button>
        </form>
      {{else}}
        <form action="guess" method="post">
          <input type="text" name="guess" autofocus />
          <button type="submit">Submit</button>
        </form>
      {{/if}}

      <p class="guess-list-title">Guesses</p>
      <ol>
        {{#each guesses}}
          <li class="{{this.result}}">
            {{this.value}}
            {{this.label}}
          </li>
        {{/each}}
      </ol>
    </div>
  </body>
</html>